opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/re2"
bug-reports: "https://github.com/public-release-reloaded/re2/issues"
dev-repo: "git+https://github.com/public-release-reloaded/re2.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/re2/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "jane_rope" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_stable_witness" {>= "v0.18~" & < "v0.19~"}
  "regex_parser_intf" {>= "v0.18~" & < "v0.19~"}
  "conf-c++"
  "dune" {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "OCaml bindings for RE2, Google's regular expression library"
description: "
"
